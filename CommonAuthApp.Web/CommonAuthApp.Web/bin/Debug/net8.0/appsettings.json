{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "",
  "ReverseProxy": {
    "Routes": {
      "AdminAuth": {
        "ClusterId": "AdminAuthCluster",
        "Match": { "Path": "/admin/Auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/admin/Auth" } ]
        /* Keep login PUBLIC: no AllowedRoles here */
      },
      "StaffAuth": {
        "ClusterId": "StaffAuthCluster",
        "Match": { "Path": "/staff/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/staff/auth" } ]
        /* Keep login PUBLIC: no AllowedRoles here */
      },
      "AdminData": {
        "ClusterId": "AdminCluster",
        "Match": { "Path": "/admin/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/admin" } ],
        "Metadata": { "AllowedRoles": "Admin" }
      },
      "StaffData": {
        "ClusterId": "StaffCluster",
        "Match": { "Path": "/staff/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/staff" } ],
        "Metadata": { "AllowedRoles": "Staff,Manager" }
      }
    },
    "Clusters": {
      "AdminAuthCluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7001/" } }
      },
      "StaffAuthCluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7002/" } }
      },
      "AdminCluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7003/" } }
      },
      "StaffCluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7004/" } }
      }
    }
  },

  "AuthenticationService": {
    "AdminValidateUrl": "https://localhost:7221/api/Auth/login",
    "StaffValidateUrl": "https://localhost:7221/api/staffauth/login"
  }
}
